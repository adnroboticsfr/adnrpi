# Ubuntu 22.04 jammy + sunxi is broken in Armbian main (26.11 regression).
# Pin to last known-good stable branch until upstream fixes it.
ARMBIAN_BRANCH="v24.11"
BOARD="adnrpi1"
BOOTSIZE="512"
BOOTFS_TYPE="fat"
RELEASE="jammy"
BUILD_DESKTOP="no"
BUILD_MINIMAL="no"
BRANCH="current"
ADNRPI_ROS="ros1"
