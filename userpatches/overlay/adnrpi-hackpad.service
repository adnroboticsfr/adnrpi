[Unit]
Description=ADNRPi HackPad — interface Kivy sous Xorg (tty1)
After=systemd-udevd.service local-fs.target adnrpi-firstboot.service
# HackPad prend vt1 — empêche getty@tty1 de tourner en même temps
Conflicts=getty@tty1.service
ConditionPathExists=/opt/adnrpi-hackpad/main.py
ConditionPathExists=/etc/adnrpi/setup.conf

[Service]
Type=simple
User=root
WorkingDirectory=/opt/adnrpi-hackpad
Environment=HOME=/root
# Supprimer un éventuel verrou Xorg résiduel
ExecStartPre=/bin/sh -c 'rm -f /tmp/.X0-lock /tmp/.X11-unix/X0'
# xinit lance Xorg sur :0/vt1 puis le wrapper launch.sh force 800x480 via xrandr
# avant de démarrer Kivy — évite que modesetting choisisse 1280x720 depuis EDID
ExecStart=/usr/bin/xinit /opt/adnrpi-hackpad/launch.sh \
    -- :0 vt1 -nolisten tcp
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
