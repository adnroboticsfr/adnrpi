[Unit]
Description=ADNRPi IR receiver — enable NEC protocol
After=systemd-udevd.service
ConditionPathExists=/sys/class/rc/rc0

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=15
ExecStart=/bin/bash -c '\
    for rc in /sys/class/rc/rc*; do \
        [ -d "$rc" ] && timeout 5 ir-keytable -s "$(basename -- "$rc")" -p NEC 2>/dev/null || true; \
    done'

[Install]
WantedBy=multi-user.target
