[Unit]
Description=ADNRPi Scope — oscilloscope Kivy sur tty1
After=systemd-udevd.service local-fs.target adnrpi-firstboot.service
Conflicts=getty@tty1.service
ConditionPathExists=/opt/adnrpi-scope/scope_screen.py
ConditionPathExists=/etc/adnrpi/setup.conf

[Service]
Type=simple
User=root
WorkingDirectory=/opt/adnrpi-scope
Environment=HOME=/root
ExecStartPre=/bin/sh -c 'rm -f /tmp/.X0-lock /tmp/.X11-unix/X0'
ExecStart=/usr/bin/xinit /opt/adnrpi-scope/launch.sh \
    -- :0 vt1 -nolisten tcp
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
