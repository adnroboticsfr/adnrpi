#!/bin/bash
# ADNRPi Setup Wizard
# Runs interactively on first boot (and after OS updates with new options).
# Can also be called manually at any time: sudo adnrpi-setup

SETUP_VERSION=1
SETUP_DIR="/etc/adnrpi"
SETUP_CONF="${SETUP_DIR}/setup.conf"
CONFIG_FILE="/boot/adnrpi-config.txt"

# ── Terminal colours ─────────────────────────────────────────────────────────
if [[ -t 1 ]]; then
    BOLD='\033[1m'; DIM='\033[2m'; NC='\033[0m'
    CYAN='\033[0;36m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'
else
    BOLD=''; DIM=''; NC=''; CYAN=''; GREEN=''; YELLOW=''
fi

# ── Helpers ──────────────────────────────────────────────────────────────────

header() {
    clear
    echo ""
    echo -e "${BOLD}  ┌─────────────────────────────────────────────┐${NC}"
    echo -e "${BOLD}  │            ADNRPi Setup Wizard               │${NC}"
    echo -e "${BOLD}  └─────────────────────────────────────────────┘${NC}"
    echo ""
}

section() {
    echo -e "  ${CYAN}── $1 $( printf '%.0s─' $(seq 1 $((45 - ${#1}))) )${NC}"
    echo ""
}

# ask VAR PROMPT DEFAULT
# Reads into the variable named by VAR.
ask() {
    local _var="$1" _prompt="$2" _default="$3" _result
    if [[ -n "$_default" ]]; then
        read -r -p "    ${_prompt} [${_default}]: " _result
        printf -v "$_var" '%s' "${_result:-$_default}"
    else
        read -r -p "    ${_prompt}: " _result
        printf -v "$_var" '%s' "$_result"
    fi
}

# ask_password VAR PROMPT DEFAULT
ask_password() {
    local _var="$1" _prompt="$2" _default="$3" _result
    read -r -s -p "    ${_prompt} [press ENTER to keep current]: " _result
    echo ""
    if [[ -z "$_result" ]] && [[ -n "$_default" ]]; then
        printf -v "$_var" '%s' "$_default"
    else
        printf -v "$_var" '%s' "$_result"
    fi
}

# yesno VAR PROMPT DEFAULT(y|n)
yesno() {
    local _var="$1" _prompt="$2" _default="${3:-n}" _result
    local _hint
    [[ "$_default" == "y" ]] && _hint="Y/n" || _hint="y/N"
    read -r -p "    ${_prompt} [${_hint}]: " _result
    _result="${_result:-$_default}"
    if [[ "${_result,,}" =~ ^y ]]; then
        printf -v "$_var" '%s' "yes"
    else
        printf -v "$_var" '%s' "no"
    fi
}

setup_needed() {
    [[ ! -f "${SETUP_CONF}" ]] && return 0
    local v
    v=$(grep "^SETUP_VERSION=" "${SETUP_CONF}" 2>/dev/null | cut -d= -f2)
    [[ "${v:-0}" -lt "${SETUP_VERSION}" ]] && return 0
    return 1
}

# ── Load existing values ──────────────────────────────────────────────────────

load_current() {
    # Hard-coded defaults (lowest priority)
    CUR_HOSTNAME="adnrpi"
    CUR_TIMEZONE="Europe/Paris"
    CUR_LOCALE="en_US.UTF-8"
    CUR_KEYBOARD_LAYOUT="us"
    CUR_KEYBOARD_VARIANT=""
    CUR_ROOT_PASSWORD="adnrpi"
    CUR_USERNAME="pi"
    CUR_USER_PASSWORD="adnrpi"
    CUR_WIFI_SSID=""
    CUR_WIFI_PASSWORD=""
    CUR_WIFI_COUNTRY="FR"

    # Boot config: initial defaults the user may have pre-filled (medium priority)
    # Only used when setup.conf does not yet exist (first run).
    if [[ ! -f "${SETUP_CONF}" ]] && [[ -f "${CONFIG_FILE}" ]]; then
        # shellcheck disable=SC1090
        source "${CONFIG_FILE}" 2>/dev/null || true
        [[ -n "${HOSTNAME}" ]]          && CUR_HOSTNAME="${HOSTNAME}"
        [[ -n "${TIMEZONE}" ]]          && CUR_TIMEZONE="${TIMEZONE}"
        [[ -n "${LOCALE}" ]]            && CUR_LOCALE="${LOCALE}"
        [[ -n "${KEYBOARD_LAYOUT}" ]]   && CUR_KEYBOARD_LAYOUT="${KEYBOARD_LAYOUT}"
        [[ -n "${KEYBOARD_VARIANT}" ]]  && CUR_KEYBOARD_VARIANT="${KEYBOARD_VARIANT}"
        [[ -n "${ROOT_PASSWORD}" ]]     && CUR_ROOT_PASSWORD="${ROOT_PASSWORD}"
        [[ -n "${USERNAME}" ]]          && CUR_USERNAME="${USERNAME}"
        [[ -n "${USER_PASSWORD}" ]]     && CUR_USER_PASSWORD="${USER_PASSWORD}"
        [[ -n "${WIFI_SSID}" ]]         && CUR_WIFI_SSID="${WIFI_SSID}"
        [[ -n "${WIFI_COUNTRY}" ]]      && CUR_WIFI_COUNTRY="${WIFI_COUNTRY}"
    fi

    # Saved setup state: wins over everything (highest priority)
    if [[ -f "${SETUP_CONF}" ]]; then
        # shellcheck disable=SC1090
        source "${SETUP_CONF}" 2>/dev/null || true
        CUR_HOSTNAME="${SAVED_HOSTNAME:-$CUR_HOSTNAME}"
        CUR_TIMEZONE="${SAVED_TIMEZONE:-$CUR_TIMEZONE}"
        CUR_LOCALE="${SAVED_LOCALE:-$CUR_LOCALE}"
        CUR_KEYBOARD_LAYOUT="${SAVED_KEYBOARD_LAYOUT:-$CUR_KEYBOARD_LAYOUT}"
        CUR_KEYBOARD_VARIANT="${SAVED_KEYBOARD_VARIANT:-$CUR_KEYBOARD_VARIANT}"
        CUR_ROOT_PASSWORD="${SAVED_ROOT_PASSWORD:-$CUR_ROOT_PASSWORD}"
        CUR_USERNAME="${SAVED_USERNAME:-$CUR_USERNAME}"
        CUR_USER_PASSWORD="${SAVED_USER_PASSWORD:-$CUR_USER_PASSWORD}"
        CUR_WIFI_SSID="${SAVED_WIFI_SSID:-$CUR_WIFI_SSID}"
        CUR_WIFI_COUNTRY="${SAVED_WIFI_COUNTRY:-$CUR_WIFI_COUNTRY}"
    fi
}

# ── Wizard steps ──────────────────────────────────────────────────────────────

step_system() {
    section "System"
    ask NEW_HOSTNAME   "Hostname"   "${CUR_HOSTNAME}"
    ask NEW_TIMEZONE   "Timezone"   "${CUR_TIMEZONE}"
    echo ""
    echo -e "    ${DIM}Language examples: en_US.UTF-8  fr_FR.UTF-8  de_DE.UTF-8${NC}"
    ask NEW_LOCALE     "Language"   "${CUR_LOCALE}"
    echo ""
}

step_keyboard() {
    section "Keyboard"
    echo -e "    ${DIM}Layout examples: us  fr  de  es  gb  it  pt${NC}"
    ask NEW_KEYBOARD_LAYOUT   "Layout"             "${CUR_KEYBOARD_LAYOUT}"
    echo -e "    ${DIM}Variant examples: (leave empty for default)  azerty  intl  nodeadkeys${NC}"
    ask NEW_KEYBOARD_VARIANT  "Variant (optional)" "${CUR_KEYBOARD_VARIANT}"
    echo ""
}

step_security() {
    section "Security"
    ask_password NEW_ROOT_PASSWORD  "Root password"  "${CUR_ROOT_PASSWORD}"

    yesno CREATE_PI "Create user '${CUR_USERNAME}'" "y"
    if [[ "$CREATE_PI" == "yes" ]]; then
        ask NEW_USERNAME      "Username"  "${CUR_USERNAME}"
        ask_password NEW_USER_PASSWORD  "Password for '${NEW_USERNAME}'"  "${CUR_USER_PASSWORD}"
    else
        NEW_USERNAME=""
        NEW_USER_PASSWORD=""
    fi
    echo ""
}

step_wifi() {
    section "WiFi (optional)"
    yesno CONFIGURE_WIFI "Configure WiFi" "$( [[ -n "${CUR_WIFI_SSID}" ]] && echo y || echo n )"
    if [[ "$CONFIGURE_WIFI" == "yes" ]]; then
        ask NEW_WIFI_SSID      "SSID (network name)"  "${CUR_WIFI_SSID}"
        ask_password NEW_WIFI_PASSWORD  "Password"     ""
        [[ -z "$NEW_WIFI_PASSWORD" ]] && NEW_WIFI_PASSWORD="${CUR_WIFI_PASSWORD}"
        ask NEW_WIFI_COUNTRY   "Country code"  "${CUR_WIFI_COUNTRY}"
    else
        NEW_WIFI_SSID="${CUR_WIFI_SSID}"
        NEW_WIFI_PASSWORD="${CUR_WIFI_PASSWORD}"
        NEW_WIFI_COUNTRY="${CUR_WIFI_COUNTRY}"
    fi
    echo ""
}

step_summary() {
    section "Summary"
    echo -e "    Hostname     : ${BOLD}${NEW_HOSTNAME}${NC}"
    echo -e "    Timezone     : ${BOLD}${NEW_TIMEZONE}${NC}"
    echo -e "    Language     : ${BOLD}${NEW_LOCALE}${NC}"
    local kb="${NEW_KEYBOARD_LAYOUT}"
    [[ -n "${NEW_KEYBOARD_VARIANT}" ]] && kb+=" / ${NEW_KEYBOARD_VARIANT}"
    echo -e "    Keyboard     : ${BOLD}${kb}${NC}"
    echo -e "    Root pass    : ${BOLD}(set)${NC}"
    if [[ "$CREATE_PI" == "yes" ]]; then
        echo -e "    User         : ${BOLD}${NEW_USERNAME}${NC}"
    else
        echo -e "    User         : ${DIM}none${NC}"
    fi
    if [[ -n "${NEW_WIFI_SSID}" ]]; then
        echo -e "    WiFi         : ${BOLD}${NEW_WIFI_SSID}${NC} (${NEW_WIFI_COUNTRY})"
    else
        echo -e "    WiFi         : ${DIM}skipped${NC}"
    fi
    echo ""
}

# ── Apply ─────────────────────────────────────────────────────────────────────

apply_hostname() {
    hostnamectl set-hostname "${NEW_HOSTNAME}" 2>/dev/null || echo "${NEW_HOSTNAME}" > /etc/hostname
    sed -i "s/127\.0\.1\.1.*/127.0.1.1\t${NEW_HOSTNAME}/" /etc/hosts 2>/dev/null
    grep -q "127.0.1.1" /etc/hosts 2>/dev/null || echo "127.0.1.1	${NEW_HOSTNAME}" >> /etc/hosts
}

apply_timezone() {
    timedatectl set-timezone "${NEW_TIMEZONE}" 2>/dev/null || \
        ln -sf "/usr/share/zoneinfo/${NEW_TIMEZONE}" /etc/localtime
}

apply_locale() {
    sed -i "s/^# *${NEW_LOCALE}/${NEW_LOCALE}/" /etc/locale.gen 2>/dev/null
    locale-gen 2>/dev/null
    update-locale LANG="${NEW_LOCALE}" 2>/dev/null
}

apply_keyboard() {
    cat > /etc/default/keyboard << EOF
XKBMODEL="pc105"
XKBLAYOUT="${NEW_KEYBOARD_LAYOUT}"
XKBVARIANT="${NEW_KEYBOARD_VARIANT}"
XKBOPTIONS=""
BACKSPACE="guess"
EOF
    setupcon --force 2>/dev/null || true
    udevadm trigger --subsystem-match=input --action=change 2>/dev/null || true
}

apply_passwords() {
    [[ -n "${NEW_ROOT_PASSWORD}" ]] && echo "root:${NEW_ROOT_PASSWORD}" | chpasswd
}

apply_user() {
    [[ "$CREATE_PI" != "yes" ]] && return
    if ! id "${NEW_USERNAME}" &>/dev/null; then
        useradd -m -G sudo,users -s /bin/bash "${NEW_USERNAME}" 2>/dev/null
    fi
    [[ -n "${NEW_USER_PASSWORD}" ]] && echo "${NEW_USERNAME}:${NEW_USER_PASSWORD}" | chpasswd
}

apply_wifi() {
    [[ -z "${NEW_WIFI_SSID}" ]] && return
    rfkill unblock wifi 2>/dev/null || true
    if command -v nmcli &>/dev/null; then
        nmcli dev wifi connect "${NEW_WIFI_SSID}" password "${NEW_WIFI_PASSWORD}" 2>/dev/null || true
    else
        local WPA_CONF="/etc/wpa_supplicant/wpa_supplicant.conf"
        mkdir -p "$(dirname "$WPA_CONF")"
        cat > "$WPA_CONF" << EOF
ctrl_interface=DIR=/var/run/wpa_supplicant GROUP=netdev
update_config=1
country=${NEW_WIFI_COUNTRY}

network={
    ssid="${NEW_WIFI_SSID}"
    psk="${NEW_WIFI_PASSWORD}"
    key_mgmt=WPA-PSK
}
EOF
        chmod 600 "$WPA_CONF"
    fi
}

save_state() {
    mkdir -p "${SETUP_DIR}"
    cat > "${SETUP_CONF}" << EOF
# ADNRPi Setup — saved configuration
# Written by adnrpi-setup v${SETUP_VERSION} on $(date '+%Y-%m-%d %H:%M:%S')
SETUP_VERSION=${SETUP_VERSION}
SAVED_HOSTNAME=${NEW_HOSTNAME}
SAVED_TIMEZONE=${NEW_TIMEZONE}
SAVED_LOCALE=${NEW_LOCALE}
SAVED_KEYBOARD_LAYOUT=${NEW_KEYBOARD_LAYOUT}
SAVED_KEYBOARD_VARIANT=${NEW_KEYBOARD_VARIANT}
SAVED_ROOT_PASSWORD=${NEW_ROOT_PASSWORD}
SAVED_USERNAME=${NEW_USERNAME}
SAVED_USER_PASSWORD=${NEW_USER_PASSWORD}
SAVED_WIFI_SSID=${NEW_WIFI_SSID}
SAVED_WIFI_COUNTRY=${NEW_WIFI_COUNTRY}
EOF
    chmod 600 "${SETUP_CONF}"

    if [[ ! -f "${SETUP_CONF}" ]]; then
        echo -e "  ${YELLOW}WARNING: Could not write ${SETUP_CONF} — setup will re-launch on next login.${NC}"
        echo -e "  ${DIM}Check that /etc/adnrpi is writable.${NC}"
    fi

    # Archive the boot config so it no longer interferes
    if [[ -f "${CONFIG_FILE}" ]]; then
        mv -f "${CONFIG_FILE}" "${CONFIG_FILE}.done" 2>/dev/null || true
    fi
}

do_apply() {
    echo ""
    echo -e "  ${YELLOW}Applying configuration…${NC}"
    echo ""
    apply_hostname   && echo -e "    ${GREEN}✓${NC} Hostname"
    apply_timezone   && echo -e "    ${GREEN}✓${NC} Timezone"
    apply_locale     && echo -e "    ${GREEN}✓${NC} Language"
    apply_keyboard   && echo -e "    ${GREEN}✓${NC} Keyboard"
    apply_passwords  && echo -e "    ${GREEN}✓${NC} Root password"
    apply_user       && [[ "$CREATE_PI" == "yes" ]] && echo -e "    ${GREEN}✓${NC} User '${NEW_USERNAME}'"
    apply_wifi       && [[ -n "${NEW_WIFI_SSID}" ]] && echo -e "    ${GREEN}✓${NC} WiFi"
    save_state
    echo ""
    echo -e "  ${BOLD}${GREEN}Setup complete!${NC}"
    echo -e "  ${DIM}Run 'adnrpi-setup' at any time to reconfigure.${NC}"
    echo ""
}

# ── Update check ──────────────────────────────────────────────────────────────

update_check() {
    local installed_ver
    installed_ver=$(grep "^SETUP_VERSION=" "${SETUP_CONF}" 2>/dev/null | cut -d= -f2)
    if [[ "${installed_ver:-0}" -lt "${SETUP_VERSION}" ]]; then
        header
        echo -e "  ${YELLOW}New configuration options are available${NC}"
        echo -e "  ${DIM}(OS update detected: setup schema ${installed_ver} → ${SETUP_VERSION})${NC}"
        echo ""
        yesno RUN_UPDATE "Review and update settings now" "y"
        [[ "$RUN_UPDATE" == "yes" ]] && return 0
        # User declined — bump version so we don't ask again until next update
        sed -i "s/^SETUP_VERSION=.*/SETUP_VERSION=${SETUP_VERSION}/" "${SETUP_CONF}"
        return 1
    fi
    return 1
}

# ── Main ──────────────────────────────────────────────────────────────────────

main() {
    # Must be root
    if [[ $EUID -ne 0 ]]; then
        echo "  Run as root: sudo adnrpi-setup"
        exit 1
    fi

    # If called with --check: exit 0 if setup needed, 1 if done
    if [[ "$1" == "--check" ]]; then
        setup_needed && exit 0 || exit 1
    fi

    load_current

    header
    echo -e "  Welcome to your ADNRPi One!"
    echo -e "  ${DIM}Press ENTER to keep the default value shown in [ ].${NC}"
    echo -e "  ${DIM}Type a new value to change it.${NC}"
    echo ""

    step_system
    step_keyboard
    step_security
    step_wifi
    step_summary

    yesno CONFIRM "Apply this configuration" "y"
    if [[ "$CONFIRM" != "yes" ]]; then
        echo ""
        echo -e "  ${DIM}Setup cancelled. Run 'adnrpi-setup' to configure later.${NC}"
        echo ""
        exit 0
    fi

    do_apply
}

main "$@"
