[Unit]
Description=ADNRPi VNC Server — framebuffer /dev/fb0 (x11vnc rawfb)
After=multi-user.target

[Service]
Type=simple
User=root
# Lecture directe du framebuffer — pas besoin de X11 ni de Xauthority
# Pour SmartPad (écran rotaté 180°) : ajouter -rotate 180 -scale 1024x600
ExecStart=/bin/sh -c '\
    if [ -f /etc/x11vnc.pass ]; then \
        exec x11vnc -rawfb /dev/fb0 \
             -forever -shared -rfbport 5900 \
             -nocursor \
             -rfbauth /etc/x11vnc.pass; \
    else \
        exec x11vnc -rawfb /dev/fb0 \
             -forever -shared -rfbport 5900 \
             -nocursor \
             -nopw; \
    fi'
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
