[Unit]
Description=ADNRPi First Boot Wizard
ConditionPathExists=!/etc/adnrpi/setup.conf
After=multi-user.target adnrpi-firstboot.service
Wants=multi-user.target
# Pas de Conflicts= ici — les ConditionPathExists sur wizard ET hackpad
# sont en miroir (l'un demarre avant setup.conf, l'autre apres) et
# assurent la mutual-exclusion sans avoir besoin de Conflicts=.
# Ajouter Conflicts= empeche hackpad de demarrer au second boot meme
# quand wizard est skippé par sa condition.

[Service]
Type=simple
ExecStart=/usr/local/bin/adnrpi-wizard-launcher.sh
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=no
# TERM indispensable pour que les couleurs et la mise en page s'affichent
Environment=TERM=linux
Environment=HOME=/root
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
